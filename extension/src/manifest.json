{
  "manifest_version": 3,
  "name": "FlashMaker",
  "version": "1.0.0",
  "description": "Extraia páginas de um PDF aberto e gere um prompt de flashcards na sidebar.",
  "action": {
    "default_title": "FlashMaker"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "offscreen",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
