{
  "manifest_version": 3,
  "name": "FlashMaker",
  "short_name": "FlashMaker",
  "version": "1.0.0",
  "description": "Transforme paginas de um PDF aberto no Chrome em um prompt para gerar flashcards.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "FlashMaker"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "offscreen",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
